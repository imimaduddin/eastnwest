{
  "rewrites": [
    {
      "source": "**",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/*/",
      "destination": "/:splat",
      "type": 301
    }
  ],
  "headers": [
    {
      "source": "**/*.@(js|css|png|jpg|jpeg|gif|svg|webp|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
